# Copy to .env and populate strong random values before running docker compose up.
# Generate secrets with: openssl rand -hex 32

VAULT_NODE_SECRET=REPLACE_WITH_RANDOM_64_HEX_NODE_SECRET
VAULT_API_KEYS=REPLACE_WITH_RANDOM_CLIENT_API_KEY
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
